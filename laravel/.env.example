APP_NAME="Punter Prediction"
APP_ENV=production
APP_KEY=base64:your-app-key-here
APP_DEBUG=false
APP_URL=https://punterprediction.com
API_URL=https://api.punterprediction.com/api/v1
# For single-file cPanel: API can be same domain /api/v1

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=punter_prediction
DB_USERNAME=root
DB_PASSWORD=

# For cPanel single-file: Use Node.js API backend
# Set API_URL to your Node.js backend URL
# Or set to /api/v1 if using single-file Node.js deployment that serves Laravel frontend via proxy

# Alternative: Use Laravel as full backend (MySQL)
# If using Laravel as backend, set DB to your cPanel MySQL

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Paystack & Flutterwave (for Laravel backend)
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
FLUTTERWAVE_SECRET_KEY=FLWSECK_...

# Sports API
SPORTS_API_KEY=
SPORTS_API_BASE_URL=https://v3.football.api-sports.io

# AI
OPENAI_API_KEY=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Frontend still available at /api/v1 if Node.js backend running
# For pure Laravel: Set API_URL to same domain and implement API in Laravel
