APP_NAME="Punter Prediction"
APP_ENV=production
APP_KEY=base64:your-app-key-generate-with-php-artisan-key-generate
APP_DEBUG=false
APP_URL=https://punterprediction.com
APP_TIMEZONE=Africa/Lagos

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - MySQL for cPanel (PostgreSQL also supported, but MySQL is cPanel native)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=punter_prediction
DB_USERNAME=punter_user
DB_PASSWORD=your_secure_password

# Alternative: PostgreSQL (if cPanel supports it, or external like Supabase)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=punter_prediction
# DB_USERNAME=punter_user
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Redis - NOT required for cPanel, using file/database drivers
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Sports API - Configurable provider
SPORTS_API_KEY=your_sports_api_key
SPORTS_API_BASE_URL=https://v3.football.api-sports.io
SPORTS_API_PROVIDER=api-sports
FOOTBALL_API_KEY=
BASKETBALL_API_KEY=
ODDS_API_KEY=

# AI Providers - Trending: OpenAI, Anthropic, Groq
AI_PRIMARY_PROVIDER=openai
AI_PRIMARY_API_KEY=sk-...
AI_SECONDARY_PROVIDER=anthropic
AI_SECONDARY_API_KEY=
AI_BACKUP_PROVIDER=groq
AI_BACKUP_API_KEY=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Payments - Paystack (NGN) - cPanel compatible
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# Flutterwave - cPanel compatible
FLUTTERWAVE_SECRET_KEY=FLWSECK_...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_...
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_ENCRYPTION_KEY=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=punter_verify_token
WHATSAPP_APP_SECRET=

# Email - cPanel SMTP or Gmail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@punterprediction.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@punterprediction.com
MAIL_FROM_NAME="${APP_NAME}"

# SMS - Termii (Nigerian provider) or Twilio
SMS_PROVIDER=termii
SMS_API_KEY=
SMS_SENDER_ID=PunterPred

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=100

# Features - All configurable via admin
ENABLE_FOOTBALL=true
ENABLE_BASKETBALL=true
ENABLE_AI_PREDICTIONS=true
ENABLE_BET_BUILDER=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_REFERRALS=true
ENABLE_WHATSAPP=true
ENABLE_COMMUNITY=true
ENABLE_ADS=true
ENABLE_GAMIFICATION=true

# Admin
ADMIN_EMAIL=admin@punterprediction.com
ADMIN_PASSWORD=ChangeMe123!

# cPanel Specific
CPANEL_COMPATIBLE=true
NO_DOCKER_REQUIRED=true
NO_REDIS_REQUIRED=true
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_COUNTRY=NG
MIN_BETTING_AGE=18

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}/api/v1"
